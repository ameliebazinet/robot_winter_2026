                "__AVR_ATmega324PA__"
            ],
            "compilerPath": "/opt/homebrew/opt/avr-gcc@14/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-x64",
            "configurationProvider": "ms-vscode.makefile-tools"
        },
        {
            "name": "Linux-PC",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",
                "/usr/include/c++/**",
                "/usr/local/include"
            ],
            "defines": [],
