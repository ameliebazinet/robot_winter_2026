{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "/**",
                "/usr/avr/include/**",
                "${workspaceFolder}/tp/tp7/lib/"
            ],
            "defines": [
                "__AVR_ATmega324PA__"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-x64",
            "configurationProvider": "ms-vscode.makefile-tools"
        },
        {
            "name": "Mac",
            "includePath": [
                "/**",
                "/opt/homebrew/opt/avr-gcc@14/avr/include/**",
                "./tp/tp7/lib/"
            ],
            "defines": [
                "__AVR_ATmega324PA__"
            ],
            "compilerPath": "/opt/homebrew/opt/avr-gcc@14/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-x64",
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ]
}
